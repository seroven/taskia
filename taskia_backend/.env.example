# Copiar a .env (local). QA y producción: .env.qa y .env.pd

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Postgres. Las tablas viven en PG_SCHEMA (no en public).
# Opción A: URL completa (Neon, Aiven, Railway, etc.)
PG_DSN=

# Opción B: campos sueltos (se usan si PG_DSN está vacío)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=postgres
PG_SCHEMA=taskia
# prefer = sin SSL (local). require / verify-full en hosting.
PG_SSLMODE=prefer

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_NAME=taskia_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cloudinary → Settings → API Keys. La foto del estudio se sube firmada desde el servidor.
# En la base solo se guarda secure_url, no el archivo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
