# MySQL origen (local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=taskia

# Cómo interpretar DATETIME naive de MySQL al pasarlos a timestamptz UTC.
# En tu MySQL local de Windows suele ser hora de Perú.
MYSQL_DATETIME_TZ=America/Lima

# PostgreSQL destino (hosting nuevo)
# Opción A: URL completa (Neon, Railway, Render, Supabase, etc.)
PG_DSN=

# Opción B: campos sueltos (se usan si PG_DSN está vacío)
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=taskia
# Schema de Postgres (equivalente a la base "taskia" de MySQL). No es public.
PG_SCHEMA=taskia
PG_SSLMODE=require
